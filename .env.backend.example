# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
APP_NAME=Nitro Type
CORS_ORIGIN=http://localhost:3000

# ── SEED ───────────────────────────────────────────────────────────────────────
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=

# ── Database ──────────────────────────────────────────────────────────────────
#Postgres
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/app

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=access-secret-min-256bits
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=refresh-secret-min-256bits
JWT_REFRESH_EXPIRES_IN=7d

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=smtp
EMAIL_FROM="Nitro Type <Nitro Type@gmail.com>"

# Resend
RESEND_API_KEY=re_xxxxxxxxxxxx

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# ── OTP ───────────────────────────────────────────────────────────────────────
OTP_EXPIRES_SECONDS=300

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_PRETTY=true

# ── Webhook ───────────────────────────────────────────────────────────────────
WEBHOOK_SECRET=webhook-hmac-secret
